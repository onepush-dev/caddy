# Caddy on Railway — reverse proxy to {$UPSTREAM}.
# Railway terminates TLS at the edge; do NOT enable auto_https here.
{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT} {
	encode gzip zstd
	reverse_proxy {$UPSTREAM} {
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		header_up X-Real-IP {http.request.header.X-Real-IP}
	}
}
